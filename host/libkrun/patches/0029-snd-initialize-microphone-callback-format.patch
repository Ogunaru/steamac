         let mut streams = streams.write().unwrap();
         let guest = &mut streams[self.id];
+        // ALSA queues RX buffers during PREPARE. Completing them before START moves the
+        // guest's hardware pointer early and traps it in an XRUN/restart loop.
+        if guest.state != PCMState::Start { return; }
         let fb = fmt.frame_bytes() as usize;
         let channels = fmt.channels;
         let mut out = Vec::new();
@@ -2667,9 +2681,16 @@
