-                    // The microphone is not up: complete the guest's buffers with silence so
-                    // its capture stream keeps flowing instead of timing out.
-                    None => space,
+                    // Permission/device startup may take seconds. Silence must advance at
+                    // the sample clock, never at the speed the guest can requeue buffers.
+                    None => {
+                        let Some((started, sent)) = self.capture_silence_clock.as_mut() else { break; };
+                        let due = (started.elapsed().as_nanos() * fmt.rate as u128 / 1_000_000_000)
+                            .min(u64::MAX as u128) as u64;
+                        let frames = due.saturating_sub(*sent).min((space / fb) as u64);
+                        *sent += frames;
+                        frames as usize * fb
+                    },
                 };
                 if produced == 0 {
                     break;
@@ -3651,6 +3672,40 @@
         assert!(weak.upgrade().is_none(), "the region is unmapped");
     }
 
+    #[test]
+    fn microphone_startup_waits_for_start_and_paces_silence() {
+        let mut host = HostStream::new(0, Direction::Input, Arc::new(Semaphore::new().unwrap()),
+                                       Arc::new(SndControl::default()));
+        host.guest_format = Some(Format { format: VIRTIO_SND_PCM_FMT_S16, rate: 48000, channels: 1 });
+        host.capture_silence_clock = Some((Instant::now(), 0));
+        let mem = GuestMemoryMmap::<()>::from_ranges(&[(GuestAddress(0), 0x1000)]).unwrap();
+        let interrupt = InterruptTransport::new(DummyIrqChip::new().into(), "snd-test".into()).unwrap();
+        let message = Arc::new(IOMessage {
+            status: AtomicU32::new(VIRTIO_SND_S_OK), used_len: 0.into(), latency_bytes: 0.into(),
+            head_index: 0,
+            response_descriptor: Descriptor { addr: 0x100, len: 8, flags: 0, next: 0 },
+            vring: Arc::new(Mutex::new(Vring { mem, queue: Queue::new(16), interrupt })),
+        });
+        let mut stream = Stream::default();
+        stream.direction = Direction::Input;
+        stream.state = PCMState::Prepare;
+        // A 10 ms capture period, queued before the guest starts recording.
+        stream.buffers.push_back(Buffer::new(
+            Descriptor { addr: 0x200, len: 960, flags: 0, next: 0 }, message.clone(), Direction::Input));
+        let streams = RwLock::new(vec![stream]);
+        std::thread::sleep(Duration::from_millis(15));
+        host.pump_input(&mut None, &streams);
+        assert_eq!(streams.read().unwrap()[0].buffers.len(), 1, "PREPARE must not consume RX");
+        streams.write().unwrap()[0].state = PCMState::Start;
+        host.capture_silence_clock = Some((Instant::now(), 0));
+        host.pump_input(&mut None, &streams);
+        assert_eq!(streams.read().unwrap()[0].buffers.len(), 1, "do not complete 10 ms at once");
+        std::thread::sleep(Duration::from_millis(15));
+        host.pump_input(&mut None, &streams);
+        assert!(streams.read().unwrap()[0].buffers.is_empty(), "complete after one period");
+        assert_eq!(message.status.load(Ordering::SeqCst), VIRTIO_SND_S_OK);
+    }
+
     /// A capture stream records from the VR headset's microphone while its host reports one:
     /// no HAL unit, the region's mic ring paced into the guest's buffers, `active` telling the
     /// host when the guest records.
